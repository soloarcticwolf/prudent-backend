# Prudent backend — local development defaults.
# Copy to .env for local use. Never commit .env with secrets.
APP_ENV=development
APP_NAME=prudent-backend
API_V1_PREFIX=/api/v1
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=prudent
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000
OPENMETEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive
OPENMETEO_TIMEOUT_S=30
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
GEOBOUNDARIES_BASE_URL=https://www.geoboundaries.org/api/current
MAX_YEAR_SPAN=60
MIN_START_YEAR=1940
MAX_END_YEAR=2025
RATE_LIMIT_PER_MIN=60
JOB_TIMEOUT_S=600
JOB_CONCURRENCY=2
CACHE_TTL_DAYS=90
LOG_LEVEL=INFO
